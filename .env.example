DATABASE_URL=postgres://gastos:gastos@127.0.0.1:5434/gastos
# Base separada para el modo invitado, sin datos reales y con conexión directa.
# Si se deja vacía, el botón de invitado no aparece.
DEMO_DATABASE_URL=postgres://gastos:gastos@127.0.0.1:5434/gastos_demo
# Resumen mensual por mail (opcional en tu compu).
# CRON_SECRET=
# RESEND_API_KEY=
# BACKUP_EMAIL=
# Remitente con dominio verificado en Resend; sin él, solo llegan mails al dueño de la cuenta de Resend.
# BACKUP_FROM="Nightspend <hola@tudominio.com>"
# openssl rand -base64 32
AUTH_SECRET=
# npm run hash-password -- "tu-contraseña"
APP_PASSWORD_HASH=
